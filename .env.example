# Inject environment variables into the process. Go does not load this file.
# Generate a token yourself. The server refuses to start with this empty value.
KAIROS_API_TOKEN=
# A separate token enables publishing and inline specifications.
KAIROS_ADMIN_TOKEN=
KAIROS_ADDR=127.0.0.1:8075
KAIROS_DB_PATH=data/kairos.db
KAIROS_WORKFLOWS_FILE=workflows/example.json
KAIROS_WORKERS=8
KAIROS_MAX_RUNS=16
KAIROS_QUEUE_SIZE=128
KAIROS_MAX_RECORDS=1000
KAIROS_RETENTION=168h
KAIROS_RUN_TIMEOUT=60s
# Opaque files, bytes per file and total retained payload bytes.
KAIROS_FILE_MAX_BYTES=33554432
KAIROS_FILE_TOTAL_BYTES=268435456
KAIROS_FILE_MAX_COUNT=1000
KAIROS_FILE_TRANSFERS=2
# Exact origins, or * for public HTTPS. Empty disables outbound HTTP.
KAIROS_HTTP_ALLOWED_ORIGINS=
KAIROS_ALLOW_PRIVATE_NETWORKS=false
# Complete header value, such as Bearer followed by your provider token.
# KAIROS_SECRET_PARTNER_AUTH=
